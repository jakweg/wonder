{
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "esbuild --outdir=dist src/websocket-server.ts",
    "prettier": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "dev": "concurrently 'esbuild --bundle --platform=node --format=esm --external:ws --outdir=dist src/websocket-server.ts --watch' 'nodemon dist/websocket-server.js'"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}