{
  "name": "EntityKind",
  "output-file": "kind",
  "add-size": true,
  "values": {
    "Invalid": {
      "#comment": "Represents invalid entity kind, should never be used",
      "max-entities": 0,
      "@store": []
    },
    "Slime": {
      "#comment": "Represents primitive slime entity, for debug and development",
      "max-entities": 2000,
      "@store": [
        { "default-from": "./stores/generation" },
        { "default-from": "./stores/position" },
        { "default-from": "./stores/facing" },
        { "default-from": "./stores/slime-metadata" },
        { "default-from": "./stores/slime-animation" },
        { "default-from": "./stores/interruptions" },
        { "default-from": "./stores/activity" }
      ]
    },
    "Steve": {
      "#comment": "Represents humanoid Steve entity",
      "max-entities": 20000,
      "@store": [
        { "default-from": "./stores/generation" },
        { "default-from": "./stores/position" },
        { "default-from": "./stores/facing" },
        { "default-from": "./stores/steve-metadata" },
        { "default-from": "./stores/skeletal-animation" },
        { "default-from": "./stores/head-look" },
        { "default-from": "./stores/interruptions" },
        { "default-from": "./stores/activity" }
      ]
    }
  },
  "getters": {
    "getEntityKindName": {
      "type": "value-identifier",
      "field": ""
    },
    "getMaxEntitiesByKind": {
      "field": "max-entities"
    },
    "getEntityKindsByStore": {
      "field": "store",
      "type": "reverse-mapping"
    },
    "listAllStores": {
      "field": "store",
      "type": "all-values"
    }
  }
}
