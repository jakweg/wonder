{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "Enum description",
  "properties": {
    "$schema": true,
    "name": {
      "type": "string",
      "minLength": 1
    },
    "output-file": {
      "type": "string",
      "minItems": 1
    },
    "add-size": {
      "type": "boolean"
    },
    "values": {
      "type": "object",
      "patternProperties": {
        "^#.*$": {
          "type": "object",
          "patternProperties": {
            "^import-prefix$": {
              "type": "string"
            },
            "^values$": {
              "type": "object",
              "^@.*$": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "from": {
                        "type": "string"
                      },
                      "property": {
                        "type": ["string", "null"]
                      }
                    },
                    "required": ["from", "property"]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "default-from": {
                        "type": "string"
                      }
                    },
                    "required": ["default-from"]
                  }
                ]
              },
              "^@@.*$": {
                "type": ["string"]
              },
              "^[^@].*$": {
                "type": ["string", "number", "boolean"]
              },
              "^#comment$": {
                "type": ["string"]
              }
            }
          },
          "required": ["import-prefix", "values"]
        },
        "^[^#].*$": {
          "type": "object",
          "patternProperties": {
            "^@.*$": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "anyOf": [{
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "property": {
                      "type": ["string", "null"]
                    }
                  },
                  "required": ["from", "property"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "default-from": {
                      "type": "string"
                    }
                  },
                  "required": ["default-from"]
                }]
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "property": {
                      "type": ["string", "null"]
                    }
                  },
                  "required": ["from", "property"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "default-from": {
                      "type": "string"
                    }
                  },
                  "required": ["default-from"]
                }
              ]
            },
            "^[^@]*$": {
              "type": ["string", "number", "boolean"]
            },
            "^#comment$": {
              "type": ["string"]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "getters": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "properties": {
            "field": {
              "type": "string"
            },
            "if-invalid-enum": {
              "enum": ["throw", "return-null", "return-undefined"]
            },
            "type": {
              "enum": ["getter", "reverse-mapping", "all-values"]
            }
          },
          "additionalProperties": false,
          "required": ["field"]
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["values", "name"],
  "additionalProperties": false
}
